# Ambiente: development, test ou production
NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORTA=3000

# Origem exata, sem barra final; HTTPS obrigatório em produção
APP_ORIGEM=http://localhost:3000

# Gere um segredo aleatório com pelo menos 32 bytes; não use este arquivo como segredo
JWT_SEGREDO=

# Origem adicional exata para o frontend em desenvolvimento
CORS_ORIGENS=http://localhost:5173,http://localhost:4173

# Destino do proxy local do frontend; não é exposto no código do navegador
WEB_API_DESTINO=http://127.0.0.1:3000

# IPs/CIDRs dos proxies confiáveis, separados por vírgula; vazio sem proxy
TRUST_PROXY=
LOG_LEVEL=info

# SQLite: absoluto ou relativo à raiz do projeto; vazio mantém database/base.sqlite
BD_ARQUIVO=database/base.sqlite

# Bootstrap explícito via npm run knex:seed; não redefine usuários existentes
ADMIN_EMAIL=administrador@email.com
ADMIN_SENHA=Senha@123
