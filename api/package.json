{
    "name": "@breve-link/api",
    "version": "1.1.0",
    "private": true,
    "main": "build/index.js",
    "scripts": {
        "dev": "ts-node-dev --transpile-only src/index.ts",
        "test": "jest --config jest.config.ts",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.test.json --noEmit",
        "start": "node build/index.js",
        "knex:make:seed": "knex --knexfile knexfile.ts seed:make",
        "knex:make:migrate": "knex --knexfile knexfile.ts migrate:make",
        "knex:seed": "knex --knexfile knexfile.ts seed:run",
        "knex:migrate": "knex --knexfile knexfile.ts migrate:latest",
        "knex:rollback": "knex --knexfile knexfile.ts migrate:rollback",
        "knex:rollback-all": "knex --knexfile knexfile.ts migrate:rollback --all"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.2.2",
        "express": "^5.1.0",
        "express-rate-limit": "^8.7.1",
        "geoip-lite": "^2.0.3",
        "helmet": "^8.3.0",
        "http-status-codes": "^2.3.0",
        "inversify": "^7.10.0",
        "jsonwebtoken": "^9.0.2",
        "knex": "^3.1.0",
        "pino": "^9.10.0",
        "reflect-metadata": "^0.2.2",
        "sqlite3": "^5.1.7",
        "ua-parser-js": "^2.0.10",
        "yup": "^1.7.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/geoip-lite": "^1.4.4",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.5.0",
        "@types/supertest": "^7.2.1",
        "jest": "^30.1.3",
        "pino-pretty": "^13.1.1",
        "supertest": "^7.3.1",
        "ts-jest": "^29.4.2",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.2"
    }
}
